# FairWork Mac Mini 4-Agent Swarm Configuration (sanitized template)
# Copy to ~/.config/fairwork-agents/config.env via ops/agents/install.sh
# Never commit real tokens or machine-specific secrets to git.

# GitHub repository in owner/repo format
FAIRWORK_GH_REPO="sweetestsj/fairwork"

# Local clone path on the Mac Mini
FAIRWORK_REPO_DIR="${HOME}/fairwork"

# Isolated git worktree root for SWE-y / Approver-y / Tester-y
FAIRWORK_WORKTREE_DIR="${HOME}/.local/state/fairwork-agents/worktrees"

# Runtime logs and lockfiles
FAIRWORK_STATE_DIR="${HOME}/.local/state/fairwork-agents"

# Ollama + Claude Code local inference settings (M4 Pro 48 GB, Ollama 0.40.16)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3-coder:30b"
ANTHROPIC_AUTH_TOKEN="ollama"

# Swarm concurrency & safety guardrails (locked-in decisions)
# Max non-overlapping PRs/issues in flight at once
MAX_IN_FLIGHT="2"

# Per-agent Claude Code turn limit and hard wall-clock timeout (seconds)
AGENT_MAX_TURNS="30"
AGENT_TIMEOUT_SECONDS="900"

# Extra flags passed to `claude` (e.g. "--permission-mode acceptEdits" or "--dangerously-skip-permissions")
CLAUDE_EXTRA_ARGS="--dangerously-skip-permissions"

# Swarm loop cadence (seconds between full cycles and between individual agent ticks)
SWARM_CYCLE_INTERVAL_SECONDS="180"
SWARM_AGENT_STAGGER_SECONDS="10"

# Log retention (days)
LOG_RETENTION_DAYS="14"
