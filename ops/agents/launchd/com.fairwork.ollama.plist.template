<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fairwork.ollama</string>

  <key>ProgramArguments</key>
  <array>
    <string>__OLLAMA_BIN__</string>
    <string>serve</string>
  </array>

  <!-- Tuned for Apple M4 Pro Mac Mini (48 GB unified memory), Ollama 0.40.16, qwen3-coder:30b -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>OLLAMA_HOST</key>
    <string>127.0.0.1:11434</string>
    <key>OLLAMA_FLASH_ATTENTION</key>
    <string>1</string>
    <key>OLLAMA_KV_CACHE_TYPE</key>
    <string>q8_0</string>
    <key>OLLAMA_CONTEXT_LENGTH</key>
    <string>32768</string>
    <key>OLLAMA_NUM_PARALLEL</key>
    <string>2</string>
    <key>OLLAMA_MAX_LOADED_MODELS</key>
    <string>1</string>
    <key>OLLAMA_KEEP_ALIVE</key>
    <string>30m</string>
    <key>OLLAMA_LOAD_TIMEOUT</key>
    <string>5m</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>__STATE_DIR__/logs/ollama.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__STATE_DIR__/logs/ollama.stderr.log</string>
</dict>
</plist>
